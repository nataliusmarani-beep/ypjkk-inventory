# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Public URL of this app. Used for CORS and for links inside emails.
FRONTEND_URL=http://localhost:5173

# ── Database & uploads (Railway: point both at the mounted volume) ─────────
# Railway example: DB_PATH=/data/bus.sqlite  UPLOAD_DIR=/data/uploads
DB_PATH=
UPLOAD_DIR=

# ── Secrets ────────────────────────────────────────────────────────────────
# Sign-in cookie. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# HMAC key for the offline-verifiable half of the bus card QR code.
# Rotating this invalidates every printed/saved card, so change it only between
# academic years. Generate: openssl rand -hex 32
QR_SECRET=change-me-too

# ── Email (Resend HTTP API — same setup as the Inventory app) ──────────────
RESEND_API_KEY=
MAIL_FROM_DOMAIN=ypj.sch.id
